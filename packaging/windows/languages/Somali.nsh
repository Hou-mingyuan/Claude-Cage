!insertmacro LANGFILE "Somali" "Soomaali" "Somali" "Somali"

${LangFileString} MUI_TEXT_WELCOME_INFO_TITLE "Ku soo dhawoow Dejinta $(^NameDA)"
${LangFileString} MUI_TEXT_WELCOME_INFO_TEXT "Dejintu waxay kugu hagi doontaa rakibaadda $(^NameDA).$\r$\n$\r$\nWaxaa lagugula talinayaa inaad xirto dhammaan barnaamijyada kale ka hor intaadan bilaabin Dejinta. Tani waxay suurtagelinaysaa in la cusbooneysiiyo faylasha nidaamka ee khuseeya iyadoon loo baahnayn in kombiyuutarkaaga dib loo bilaabo.$\r$\n$\r$\n$_CLICK"
${LangFileString} MUI_TEXT_LICENSE_TITLE "Heshiiska shatiga"
${LangFileString} MUI_TEXT_LICENSE_SUBTITLE "Fadlan dib u eeg shuruudaha shatiga ka hor intaadan rakibin $(^NameDA)."
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM "Haddii aad aqbasho shuruudaha heshiiska, guji Waan aqbalay si aad u sii wadato. Waa inaad aqbashaa heshiiska si aad u rakibto $(^NameDA)."
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM_CHECKBOX "Haddii aad aqbasho shuruudaha heshiiska, calaamadee sanduuqa hoose. Waa inaad aqbashaa heshiiska si aad u rakibto $(^NameDA). $_CLICK"
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM_RADIOBUTTONS "Haddii aad aqbasho shuruudaha heshiiska, dooro doorashada koowaad ee hoose. Waa inaad aqbashaa heshiiska si aad u rakibto $(^NameDA). $_CLICK"
${LangFileString} MUI_INNERTEXT_LICENSE_TOP "Riix Page Down si aad u aragto inta ka hartay heshiiska."
${LangFileString} MUI_TEXT_DIRECTORY_TITLE "Dooro Goobta Rakibaadda"
${LangFileString} MUI_TEXT_DIRECTORY_SUBTITLE "Dooro galka aad $(^NameDA) ku rakibayso."
${LangFileString} MUI_TEXT_INSTALLING_TITLE "Waa la rakibayaa"
${LangFileString} MUI_TEXT_INSTALLING_SUBTITLE "Fadlan sug inta $(^NameDA) la rakibayo."
${LangFileString} MUI_TEXT_FINISH_TITLE "Rakibaaddu Waa Dhammaatay"
${LangFileString} MUI_TEXT_FINISH_SUBTITLE "Dejintu si guul leh ayay u dhammaatay."
${LangFileString} MUI_TEXT_ABORT_TITLE "Rakibaadda Waa La Joojiyay"
${LangFileString} MUI_TEXT_ABORT_SUBTITLE "Dejintu si guul leh uma dhammaan."
${LangFileString} MUI_UNTEXT_UNINSTALLING_TITLE "Waa laga saarayaa"
${LangFileString} MUI_UNTEXT_UNINSTALLING_SUBTITLE "Fadlan sug inta $(^NameDA) laga saarayo."
${LangFileString} MUI_UNTEXT_FINISH_TITLE "Ka saariddu Waa Dhammaatay"
${LangFileString} MUI_UNTEXT_FINISH_SUBTITLE "Ka saariddu si guul leh ayay u dhammaatay."
${LangFileString} MUI_UNTEXT_ABORT_TITLE "Ka saaridda Waa La Joojiyay"
${LangFileString} MUI_UNTEXT_ABORT_SUBTITLE "Ka saariddu si guul leh uma dhammaan."
${LangFileString} MUI_TEXT_FINISH_INFO_TITLE "Dhammaystirka Dejinta $(^NameDA)"
${LangFileString} MUI_TEXT_FINISH_INFO_TEXT "$(^NameDA) waa lagu rakibay kombiyuutarkaaga.$\r$\n$\r$\nGuji Dhammee si aad u xirto Dejinta."
${LangFileString} MUI_TEXT_FINISH_INFO_REBOOT "Kombiyuutarkaaga waa in dib loo bilaabaa si loo dhammaystiro rakibaadda $(^NameDA). Ma rabtaa inaad hadda dib u bilowdo?"
${LangFileString} MUI_TEXT_FINISH_REBOOTNOW "Hadda dib u bilow"
${LangFileString} MUI_TEXT_FINISH_REBOOTLATER "Waxaan rabaa inaan gacanta dib ugu bilaabo hadhow"
${LangFileString} MUI_TEXT_FINISH_RUN "&Socodsii $(^NameDA)"
${LangFileString} MUI_TEXT_FINISH_SHOWREADME "&Muuji Readme"
${LangFileString} MUI_BUTTONTEXT_FINISH "&Dhammee"
