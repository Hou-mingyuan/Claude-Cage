!insertmacro LANGFILE "Dari" "دری" "Dari" "Dari"

${LangFileString} MUI_TEXT_WELCOME_INFO_TITLE "به برنامهٔ نصب $(^NameDA) خوش آمدید"
${LangFileString} MUI_TEXT_WELCOME_INFO_TEXT "برنامهٔ نصب شما را در مراحل نصب $(^NameDA) راهنمایی می‌کند.$\r$\n$\r$\nتوصیه می‌شود پیش از آغاز نصب، همهٔ برنامه‌های دیگر را ببندید. این کار امکان به‌روزرسانی فایل‌های سیستمی مربوط را بدون راه‌اندازی دوبارهٔ کمپیوتر فراهم می‌کند.$\r$\n$\r$\n$_CLICK"
${LangFileString} MUI_TEXT_LICENSE_TITLE "موافقت‌نامهٔ جواز"
${LangFileString} MUI_TEXT_LICENSE_SUBTITLE "لطفاً پیش از نصب $(^NameDA) شرایط جواز را مرور کنید."
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM "اگر شرایط موافقت‌نامه را می‌پذیرید، برای ادامه روی «موافقم» کلیک کنید. برای نصب $(^NameDA) باید موافقت‌نامه را بپذیرید."
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM_CHECKBOX "اگر شرایط موافقت‌نامه را می‌پذیرید، کادر زیر را تیک بزنید. برای نصب $(^NameDA) باید موافقت‌نامه را بپذیرید. $_CLICK"
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM_RADIOBUTTONS "اگر شرایط موافقت‌نامه را می‌پذیرید، گزینهٔ اول زیر را انتخاب کنید. برای نصب $(^NameDA) باید موافقت‌نامه را بپذیرید. $_CLICK"
${LangFileString} MUI_INNERTEXT_LICENSE_TOP "برای دیدن بقیهٔ موافقت‌نامه، کلید Page Down را فشار دهید."
${LangFileString} MUI_TEXT_DIRECTORY_TITLE "انتخاب موقعیت نصب"
${LangFileString} MUI_TEXT_DIRECTORY_SUBTITLE "پوشه‌ای را که می‌خواهید $(^NameDA) در آن نصب شود انتخاب کنید."
${LangFileString} MUI_TEXT_INSTALLING_TITLE "در حال نصب"
${LangFileString} MUI_TEXT_INSTALLING_SUBTITLE "لطفاً صبر کنید تا $(^NameDA) نصب شود."
${LangFileString} MUI_TEXT_FINISH_TITLE "نصب تکمیل شد"
${LangFileString} MUI_TEXT_FINISH_SUBTITLE "نصب با موفقیت تکمیل شد."
${LangFileString} MUI_TEXT_ABORT_TITLE "نصب لغو شد"
${LangFileString} MUI_TEXT_ABORT_SUBTITLE "نصب با موفقیت تکمیل نشد."
${LangFileString} MUI_UNTEXT_UNINSTALLING_TITLE "در حال حذف نصب"
${LangFileString} MUI_UNTEXT_UNINSTALLING_SUBTITLE "لطفاً صبر کنید تا $(^NameDA) حذف شود."
${LangFileString} MUI_UNTEXT_FINISH_TITLE "حذف نصب تکمیل شد"
${LangFileString} MUI_UNTEXT_FINISH_SUBTITLE "حذف نصب با موفقیت تکمیل شد."
${LangFileString} MUI_UNTEXT_ABORT_TITLE "حذف نصب لغو شد"
${LangFileString} MUI_UNTEXT_ABORT_SUBTITLE "حذف نصب با موفقیت تکمیل نشد."
${LangFileString} MUI_TEXT_FINISH_INFO_TITLE "پایان نصب $(^NameDA)"
${LangFileString} MUI_TEXT_FINISH_INFO_TEXT "$(^NameDA) روی کمپیوتر شما نصب شد.$\r$\n$\r$\nبرای بستن برنامهٔ نصب روی «پایان» کلیک کنید."
${LangFileString} MUI_TEXT_FINISH_INFO_REBOOT "برای تکمیل نصب $(^NameDA) باید کمپیوتر شما دوباره راه‌اندازی شود. آیا می‌خواهید همین حالا راه‌اندازی دوباره کنید؟"
${LangFileString} MUI_TEXT_FINISH_REBOOTNOW "همین حالا راه‌اندازی دوباره شود"
${LangFileString} MUI_TEXT_FINISH_REBOOTLATER "بعداً خودم دوباره راه‌اندازی می‌کنم"
${LangFileString} MUI_TEXT_FINISH_RUN "&اجرای $(^NameDA)"
${LangFileString} MUI_TEXT_FINISH_SHOWREADME "&نمایش فایل راهنما"
${LangFileString} MUI_BUTTONTEXT_FINISH "&پایان"
${LangFileString} MUI_UNTEXT_CONFIRM_TITLE "حذف نصب $(^NameDA)"
${LangFileString} MUI_UNTEXT_CONFIRM_SUBTITLE "$(^NameDA) را از کمپیوتر خود حذف کنید."
${LangFileString} MUI_TEXT_ABORTWARNING "آیا مطمئن هستید که می‌خواهید از برنامهٔ نصب $(^Name) خارج شوید؟"
