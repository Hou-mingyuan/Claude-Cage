Cage builds two Windows executables and stages their DLLs separately.
Allow that build to skip the post-configuration symlinks to install targets
that have yet to be built, while keeping the default QEMU install bundle.

--- a/meson.build
+++ b/meson.build
@@ -18 +18,3 @@
-meson.add_postconf_script(find_program('scripts/symlink-install-tree.py'))
+if get_option('cage_install_bundle')
+  meson.add_postconf_script(find_program('scripts/symlink-install-tree.py'))
+endif
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -5,2 +5,4 @@
+option('cage_install_bundle', type: 'boolean', value: true,
+       description: 'Create the configure-time qemu-bundle install symlinks')
 option('qemu_suffix', type : 'string', value: 'qemu',
        description: 'Suffix for QEMU data/modules/config directories (can be empty)')
