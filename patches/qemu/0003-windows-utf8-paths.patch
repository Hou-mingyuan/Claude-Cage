QEMU uses narrow Win32 and UCRT file APIs to locate and load its firmware.
Select UTF-8 for those APIs in the emulator and tools, retaining MinGW's
asInvoker and supportedOS declarations.

--- a/meson.build
+++ b/meson.build
@@ -853,7 +853,7 @@
 
   win = import('windows')
   version_res = win.compile_resources('version.rc',
-                                      depend_files: files('pc-bios/qemu-nsis.ico'),
+                                      depend_files: files('pc-bios/qemu-nsis.ico', 'qemu-win32.manifest'),
                                       include_directories: include_directories('.'))
   host_dsosuf = '.dll'
 elif host_os == 'darwin'
--- a/version.rc
+++ b/version.rc
@@ -1,3 +1,4 @@
+#include <winuser.rh>
 #include <winver.h>
 #include "config-host.h"
 
@@ -31,3 +32,5 @@
 }
 
 IDI_ICON1 ICON "pc-bios/qemu-nsis.ico"
+
+CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "qemu-win32.manifest"
--- /dev/null
+++ b/qemu-win32.manifest
@@ -0,0 +1,20 @@
